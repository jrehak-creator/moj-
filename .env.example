# Optional server-only AI search. Keep your actual key in the ignored .env file
# or Render's private Environment settings. Never commit it.
NEST_AI_API_KEY=

# Optional override; leaving this blank uses gpt-5-mini.
NEST_AI_MODEL=

# Optional parent PIN recovery: set privately to 6–12 digits.
# Keep this commented out unless you intend to configure a parent PIN override.
# PARENT_PIN_OVERRIDE=

# Optional server-only source for verified YouTube durations.
# YOUTUBE_API_KEY=
